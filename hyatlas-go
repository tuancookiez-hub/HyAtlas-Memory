#!/usr/bin/env bash
# HyAtlas v4 control wrapper (mirrors `hyatlas start|stop|status` for the Go server).
# v4 lives at F:\HyAtlas-Memory-Go on port 19528.

set -euo pipefail
HYATLAS_GO_DIR="F:/HyAtlas-Memory-Go"
HYATLAS_GO_PORT="19528"
HYATLAS_GO_DATA="${HYATLAS_GO_DIR}/data"
HYATLAS_GO_EXE="${HYATLAS_GO_DIR}/hyatlas-go.exe"

cmd="${1:-help}"

start_server() {
  cmd.exe //c "${HYATLAS_GO_DIR}\\hyatlas-v4-start.bat"
}

stop_server() {
  tasklist //FI "IMAGENAME eq hyatlas-go.exe" //NH 2>/dev/null \
    | awk '/hyatlas-go.exe/ {print $2}' \
    | while read -r pid; do
        taskkill //F //PID "$pid" >/dev/null 2>&1 && echo "Stopped hyatlas-go.exe (pid $pid)"
      done
}

print_status() {
  echo "v4 server:  127.0.0.1:${HYATLAS_GO_PORT}"
  echo
  if curl -sS --max-time 3 "http://127.0.0.1:${HYATLAS_GO_PORT}/healthz"; then echo; fi
  echo
  if curl -sS --max-time 3 "http://127.0.0.1:${HYATLAS_GO_PORT}/api/v1/status"; then echo; fi
  echo
  echo "v3.5 server (Python/zvec):  127.0.0.1:19527"
}

case "$cmd" in
  start)   start_server ;;
  stop)    stop_server ;;
  restart) stop_server; sleep 1; start_server ;;
  status|health) print_status ;;
  help|-h|--help|"") cat <<EOF
HyAtlas v4 control wrapper

  hyatlas-go start     Start the Go server (detached)
  hyatlas-go stop      Stop the Go server
  hyatlas-go restart   Stop then start
  hyatlas-go status    Probe /healthz + /api/v1/status
  hyatlas-go help      This message

v4 listens on 127.0.0.1:${HYATLAS_GO_PORT}. v3.5 (Python/zvec) still on 19527.
EOF
  ;;
  *) echo "hyatlas-go: unknown command '$cmd' (try 'hyatlas-go help')" >&2; exit 2 ;;
esac
