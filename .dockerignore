.git/
.github/
.vscode/
.idea/
*.swp
.worktrees/

# Secrets and local config
.env
.env.*
!.env.example
*.pem
*.key
*.log

# OS
.DS_Store
Thumbs.db

# Scratch files
*.tmp
*.bak
cache/
logs/
snapshots/

# Docs not needed at runtime (source kept in repo, built into the binary)
# README.md, CHANGELOG.md, CONTRIBUTING.md, V3_V4_COMPARISON.md are NOT excluded
# so the dashboard can serve them.
docs/
handoff.md
NOW.md
TUNA_AGENT_OS_TASK_BRIEF.md
ROADMAP_v2_public.md
v3-upgrade-overview.jpeg

# Assets not needed at runtime (banner images are cosmetic, not required for the binary)
# The dashboard uses embedded HTML/CSS/JS, not the assets/ folder.
assets/
