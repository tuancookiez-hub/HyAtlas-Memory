# ----------------------------------------------------------------------
# NEVER COMMIT — these files contain real API keys, credentials, or
# user data. Listed here so even `git add -A` cannot accidentally stage
# them. The .example versions ARE committed.
# ----------------------------------------------------------------------
.env
.env.local
*.env
!*.example.env
hy_memory.json
hy_memory.local.json
auth.json
credentials.json
token.json
*.pem
