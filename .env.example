# Example env for HyAtlas v4.0 — pure Go.
# Copy to `.env` next to docker-compose.yml, or set these in your shell.

# LLM (async fact extraction, summary, schema, intention)
# Use a Nous Portal :free model. Any id ending in :free is valid.
HYATLAS_LLM_BASE=https://inference-api.nousresearch.com/v1
HYATLAS_LLM_MODEL=poolside/laguna-s-2.1:free
HYATLAS_LLM_KEY=YOUR_NOUS_AGENT_KEY_HERE
# Optional: read the key live from a file each call instead of freezing it at
# startup — for rotating credentials (e.g. the 1-hour JWT Hermes keeps fresh in
# its auth.json). Accepts that auth.json shape (providers.nous.agent_key /
# access_token) or a plain-text file holding the bare token. When set, wins over
# HYATLAS_LLM_KEY, which then acts as the fallback if the file is unreadable.
#   HYATLAS_LLM_KEY_FILE=/path/to/auth.json

# Embeddings — v4 uses in-process BGE-small by default; no env vars needed.
# Override only if you want the on-disk model files:
#   HYATLAS_EMBED_BASE=disk    (reads models/bge-small-en-v1.5.*)
#   HYATLAS_EMBED_BASE=bge     (default; uses -tags embedded build)

# Port (loopback only by default — no external surface)
HYATLAS_PORT=19528

# Optional: data directory (default: ./data)
# HYATLAS_DATA_DIR=/var/lib/hyatlas

# Optional: bind address (default 127.0.0.1 — loopback only)
# HYATLAS_BIND=0.0.0.0

# Extraction mode — a ladder of reasoning scope, not of latency:
#   lite   no LLM call; conversation text never leaves the machine (1/7 layers: L2)
#   pro    one extraction per write; reasons within that single turn
#          (5/7 layers: L1,L2,L3,L4,L7 — System1)
#   ultra  pro plus the slow path: periodic consolidation across memories,
#          which adds L5 knowledge and L6 schemas (7/7 layers — System1+System2)
HYATLAS_MODE=ultra

# Whether a write BLOCKS on extraction (separate from the mode above).
# Unset follows the mode: pro blocks, ultra returns immediately.
#HYATLAS_SYNC_EXTRACT=off

# Ultra only — slow-path tuning.
#HYATLAS_CONSOLIDATE_EVERY=6h
#HYATLAS_CONSOLIDATE_BATCH=200
# Age after which L2 Raw memories no graph edge cites are decayed.
# Unset means raw history is never deleted.
#HYATLAS_RAW_RETENTION=90d
HYATLAS_MODE=ultra
