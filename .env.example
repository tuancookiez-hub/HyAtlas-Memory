# Example env for HyAtlas v4 — pure Go.
# Set these in the shell or service unit that starts hyatlas-go.

# LLM (fact extraction, summary, schema, intention)
# Any OpenAI-compatible endpoint works — Nous Portal, a local ollama/vLLM/
# llama.cpp server, or anything else. The model id is whatever that endpoint
# serves; a Nous Portal :free id is only one option among many.
# No endpoint is assumed by the server. Extraction sends memory text to whatever
# you set here, so it is your choice: any OpenAI-compatible API works, including
# a local one. Leave these unset and writes store the raw trace only, with
# llm=unconfigured in status (or run HYATLAS_MODE=lite for no LLM at all).
#
# The values below are a free Nous Portal endpoint, offered as a starting point
# by the installer (scripts/install.sh) -- uncomment to use it. `hermes memory
# setup` has no default endpoint; enter any OpenAI-compatible URL there.
#HYATLAS_LLM_BASE=https://inference-api.nousresearch.com/v1
#HYATLAS_LLM_MODEL=poolside/laguna-s-2.1:free
#HYATLAS_LLM_KEY=YOUR_KEY_HERE
# Optional: read the key live from a file each call instead of freezing it at
# startup — for rotating credentials (e.g. the 1-hour JWT Hermes keeps fresh in
# its auth.json). Accepts that auth.json shape (providers.nous.agent_key /
# access_token) or a plain-text file holding the bare token. When set, wins over
# HYATLAS_LLM_KEY, which then acts as the fallback if the file is unreadable.
#   HYATLAS_LLM_KEY_FILE=/path/to/auth.json

# Embeddings — in-process BGE-small by default; no env vars needed.
#   HYATLAS_EMBED_BASE=bge     (default; the release binary bundles the model.
#                               A plain build reads HYATLAS_MODEL_DIR when set,
#                               else <cwd>/models, <exe dir>/models, then
#                               ~/.hyatlas/models)
#   HYATLAS_EMBED_BASE=local   (offline deterministic stub, for tests)
#   HYATLAS_EMBED_BASE=https://...  (any OpenAI-compatible embeddings URL —
#                               memory text then leaves the machine, in every mode)

# Port (loopback only by default — no external surface)
HYATLAS_GO_PORT=19528

# Extra hostnames accepted in the Host and Origin headers, comma-separated (for
# example behind a reverse proxy). By default only localhost and IP literals are
# accepted, which blocks DNS rebinding. Leave unset unless you need it.
#HYATLAS_ALLOWED_HOSTS=memory.example.internal

# Optional: data directory (default: ./data)
# HYATLAS_GO_DATA=/var/lib/hyatlas

# Optional: bind address (default 127.0.0.1 — loopback only). The server has no
# authentication, so do not bind it to a network interface you do not trust.
# HYATLAS_GO_HOST=0.0.0.0

# Extraction mode — a ladder of reasoning scope, not of latency:
#   lite   no LLM call, so no text goes to an LLM; with the default local
#          embeddings nothing leaves the machine (1/7 layers: L2)
#   pro    one extraction per write; reasons within that single turn
#          (5/7 layers: L1,L2,L3,L4,L7 — System1)
#   ultra  pro plus the slow path: periodic consolidation across memories,
#          which adds L5 knowledge and L6 schemas (7/7 layers — System1+System2)
HYATLAS_MODE=ultra

# Whether a write BLOCKS on extraction (separate from the mode above).
# Unset follows the mode: pro blocks, ultra returns immediately. (A server the
# Hermes plugin spawns defaults to off.)
#HYATLAS_SYNC_EXTRACT=off

# Ultra only — slow-path tuning. The interval must be positive in ultra; use
# HYATLAS_MODE=pro if you do not want the periodic pass.
#HYATLAS_CONSOLIDATE_EVERY=6h
#HYATLAS_CONSOLIDATE_BATCH=200
# Age after which L2 Raw memories no graph edge cites are decayed.
# Unset means raw history is never deleted.
#HYATLAS_RAW_RETENTION=90d
