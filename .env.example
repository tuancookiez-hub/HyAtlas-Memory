# Example env for Docker / host. Copy to `.env` next to docker-compose.yml
# or into `$HYATLAS_HOME/config/.env`.

# LLM (L2 extraction + System 2 digest) — required for pro/ultra
HY_MEMORY_LLM_API_KEY=YOUR_LLM_API_KEY_HERE
HY_MEMORY_LLM_MODEL=gpt-4o-mini
HY_MEMORY_LLM_BASE_URL=https://api.openai.com/v1

# Embeddings
# Docker default (small image): remote OpenAI-compatible embeddings
HY_MEMORY_EMBEDDER_PROVIDER=remote
HY_MEMORY_EMBEDDER_MODEL=text-embedding-3-small
HY_MEMORY_EMBEDDER_DIMS=1536
HY_MEMORY_EMBEDDER_API_KEY=
# For local BGE (native `hyatlas start` or compose profile `local-embed`):
# HY_MEMORY_EMBEDDER_PROVIDER=local
# HY_MEMORY_EMBEDDER_MODEL=BAAI/bge-large-en-v1.5
# HY_MEMORY_EMBEDDER_DIMS=1024

# Vector store (zvec only since v3.1; Qdrant removed from live path in v3.4)
HY_MEMORY_VECTOR_STORE=zvec

# Runtime mode: lite | pro | ultra
MEMORY_MODE=ultra

# Ports (Docker binds 0.0.0.0 inside the container; published to host)
HY_MEMORY_PORT=19527
HY_DASH_PORT=8765

# Optional cadence knobs
HY_MEMORY_L3_TRIGGER_EVERY=20
HY_MEMORY_L5_SCHEDULE=manual
