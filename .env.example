# Example env for HyAtlas v4.0 — pure Go.
# Copy to `.env` next to docker-compose.yml, or set these in your shell.

# LLM (async fact extraction, summary, schema, intention)
# Point at any OpenAI-compatible endpoint.
HYATLAS_LLM_BASE=http://127.0.0.1:49200/v1
HYATLAS_LLM_MODEL=deepseek:deepseek-v4-flash
HYATLAS_LLM_KEY=YOUR_LLM_API_KEY_HERE

# Embeddings — v4 uses in-process BGE-small by default; no env vars needed.
# Override only if you want the on-disk model files:
#   HYATLAS_EMBED_BASE=disk    (reads models/bge-small-en-v1.5.*)
#   HYATLAS_EMBED_BASE=bge     (default; uses -tags embedded build)

# Port (loopback only by default — no external surface)
HYATLAS_PORT=19528

# Optional: data directory (default: ./data)
# HYATLAS_DATA_DIR=/var/lib/hyatlas

# Optional: bind address (default 127.0.0.1 — loopback only)
# HYATLAS_BIND=0.0.0.0
