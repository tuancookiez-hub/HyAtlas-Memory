# Example env file. Copy to ~/.env and fill in your real keys.
# hyatlas-memory reads these via os.environ at startup.

# LLM provider (used for L2 fact extraction + L3 summary generation)
HY_MEMORY_LLM_API_KEY=YOUR_LLM_API_KEY_HERE
HY_MEMORY_LLM_MODEL=gpt-4o-mini
HY_MEMORY_LLM_BASE_URL=https://api.openai.com/v1

# Embedding provider (used for L4 identity search vectorization)
HY_MEMORY_EMBEDDER_API_KEY=YOUR_EMBEDDER_API_KEY_HERE
HY_MEMORY_EMBEDDER_MODEL=BAAI/bge-small-en-v1.5

# Vector store backend. HyAtlas uses zvec (in-process, no external binary).
HY_MEMORY_VECTOR_STORE=zvec

# HyAtlas server (started automatically if `auto_start: true` in hy_memory.json)
HY_MEMORY_PORT=19527

# L3 summary cadence. Default: every 20 adds. Lower = more frequent
# rollups; higher = less LLM cost per add.
HY_MEMORY_L3_TRIGGER_EVERY=20

# L5 pipeline schedule. Options: manual, hourly, daily.
HY_MEMORY_L5_SCHEDULE=manual
