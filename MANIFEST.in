include README.md
include LICENSE
include CHANGELOG.md

# Ship the bundled server (upstream + dashboard) so `pip install hyatlas-memory`
# makes `hyatlas start` work from any directory. The package_data spec in
# pyproject.toml covers Python-file discovery; this MANIFEST.in covers
# everything that isn't a .py file.

recursive-include src/hyatlas_memory/server *.html
recursive-include src/hyatlas_memory/server *.css
recursive-include src/hyatlas_memory/server *.js
recursive-include src/hyatlas_memory/server *.json
recursive-include src/hyatlas_memory/server *.yaml
recursive-include src/hyatlas_memory/server *.png

# Exclude runtime artifacts that should never ship
prune **/__pycache__
prune **/logs
prune **/.pytest_cache
prune **/*.pyc
prune **/*.pyo